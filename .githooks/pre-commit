#!/bin/sh
# Repository guardrails: scripts/check.ps1 -Fast (parse, cmdlet count, wording, tools.json).
# Installed with: powershell -File scripts/install-hooks.ps1  (git config core.hooksPath .githooks)
# Emergency bypass only: git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check.ps1" -Fast
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: scripts/check.ps1 -Fast failed (exit $status); commit aborted." >&2
fi
exit $status
