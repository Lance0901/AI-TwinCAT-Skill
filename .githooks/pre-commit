#!/bin/sh
# Repository guardrails: scripts/check.ps1 -Fast (parse, encoding, cmdlet count, wording,
# error codes, tools.json; npm test is left to CI / a manual full run).
# NOTE: check.ps1 reads the WORKING TREE, not the git index. Unstaged edits are checked too,
# and a partially staged file is judged by its working-tree content.
# Installed with: powershell -File scripts/install-hooks.ps1  (git config core.hooksPath .githooks)
# Emergency bypass only: git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check.ps1" -Fast
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: scripts/check.ps1 -Fast failed (exit $status); commit aborted." >&2
fi
exit $status
